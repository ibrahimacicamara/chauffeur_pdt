rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'YGE0x3Im8XUtmxWBtD740mszQ3B2';
    }

    match /{document=**} {
      allow read, write: if isAdmin() || request.auth != null;
    }
  }
}
